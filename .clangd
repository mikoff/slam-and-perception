# Root clangd configuration for multi-project workspace
# Per-project CompilationDatabase paths route each subproject to its build dir.

CompileFlags:
  # Remove GCC-specific flags that clangd/clang cannot process:
  # -fopenmp requires libomp-dev for clang (omp.h); not needed for intellisense.
  Remove: [-fopenmp]

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - cppcoreguidelines-*
      - google-*
      - modernize-*
      - performance-*
      - readability-*
    Remove:
      - modernize-use-trailing-return-type
      - cppcoreguidelines-avoid-magic-numbers
      - readability-magic-numbers
  UnusedIncludes: Strict

---

# Treat .inl files as C++ headers (avoids "not part of any TU" errors)
If:
  PathMatch: .*\.inl
CompileFlags:
  Add: [-xc++-header]

---

# Treat .hpp files as C++ headers when opened standalone
If:
  PathMatch: .*\.hpp
CompileFlags:
  Add: [-xc++-header]

---

# gtsam project
If:
  PathMatch: projects/gtsam/.*
CompileFlags:
  CompilationDatabase: projects/gtsam/build

---

# slam-types project
If:
  PathMatch: projects/slam-types/.*
CompileFlags:
  CompilationDatabase: projects/slam-types/build

---

# symforce project
If:
  PathMatch: projects/symforce/.*
CompileFlags:
  CompilationDatabase: projects/symforce/build

---

# dummy project
If:
  PathMatch: dummy_project/.*
CompileFlags:
  CompilationDatabase: dummy_project/build
