        "extrinsic_prior_trans_sigma": 0.05,
        "min_inliers": 0,
        "max_registration_error": 1e9,
        "max_translation_m": 1e9,
        "imu_consistency_threshold": 0.0
    },
    "radar": {
        "velocity_sigma": 1.5,
        "robust_threshold": 0.5,
        "extrinsic_prior_rot_sigma": 1e-4,
        "extrinsic_prior_yaw_sigma": 1e-2,
        "extrinsic_prior_trans_xy": 1e-2,
        "extrinsic_prior_trans_z": 1e-4
    },
    "nhc": {
        "lateral_sigma": 0.1,
        "vertical_sigma": 0.1,
        "lever_arm_x": 0.0,
        "lever_arm_y": 0.0,
        "lever_arm_z": 0.0
    },
    "forward_velocity": {
        "sigma": 0.5,
        "scale_prior_sigma": 0.001
