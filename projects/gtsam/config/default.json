{
    "sensors": {
        "enable_gps": true,
        "enable_lidar": true,
        "enable_radar": true,
        "enable_nhc": true,
        "enable_fwdvel": true,
        "gps_max_measurements": 0
    },
    "prior": {
        "pose_rot_sigma": 0.05,
        "pose_trans_sigma": 0.5,
        "velocity_sigma": 0.1,
        "bias_accel_sigma": 0.1,
        "bias_gyro_sigma": 0.003,
        "bias_gyro_sigma_obs": 0.1
    },
    "gps": {
        "sigma": 1.0,
        "robust_threshold": 1.345
    },
    "lidar": {
        "odom_rot_sigma": 0.05,
        "odom_trans_sigma": 0.1,
        "robust_threshold": 0.5,
